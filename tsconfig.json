{
  "compilerOptions": {
    "target": "es2016",
    "module": "commonjs",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "moduleResolution": "bundler",
    "paths": {
      "openclaw/plugin-sdk": ["../openclaw/src/plugin-sdk/index.ts"],
      "openclaw/plugin-sdk/*": ["../openclaw/src/plugin-sdk/*.ts"]
    },
    "types": ["node"]
  },
  "include": ["src"]
}