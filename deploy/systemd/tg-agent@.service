[Unit]
Description=Telegram agent dispatcher for %i
After=network.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/.openclaw/extensions/telegram-user-tool
ExecStart=/root/.openclaw/extensions/telegram-user-tool/node_modules/.bin/tsx src/scripts/dispatcher.ts --agent %i
EnvironmentFile=-/root/.openclaw/codex-auth/.env
Slice=tg-agents.slice
TimeoutStartSec=3600
StandardOutput=journal
StandardError=journal
