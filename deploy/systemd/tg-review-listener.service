[Unit]
Description=Post-comment-review Telegram bot listener (post-comment-review)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/openclaw-plugins/telegram-user-tool
ExecStart=/root/openclaw-plugins/telegram-user-tool/node_modules/.bin/tsx src/scripts/periodic/review-listener.ts
EnvironmentFile=-/root/.openclaw/secrets.env
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
