# Дневная воронка по всем агентам → Saved Messages получателя отчётов.
# Oneshot, запускается таймером tg-funnel-tracker.timer раз в день.
# --admin <agentId>   — владелец данных (funnel.db/reports/, здесь: agent1).
# --send-as <agentId> — аккаунт-получатель отчёта (здесь: agent27, REPORT_AGENT_ID;
#                       не выполняет рабочих задач, исключён из listAgentIds()).
# ID приватного канала воронки задаётся per-persona в profile_data.json персоны
# (поле funnelPrivateChannelId, per-persona-funnel-channel) — отдельного аргумента нет.

[Unit]
Description=Telegram funnel tracker (all agents -> report recipient Saved Messages)
After=network.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/openclaw-plugins/telegram-user-tool
ExecStart=/root/openclaw-plugins/telegram-user-tool/node_modules/.bin/tsx src/scripts/periodic/funnel-tracker.ts --admin agent1 --send-as agent27
EnvironmentFile=-/root/.openclaw/codex-auth/.env
EnvironmentFile=-/root/.openclaw/secrets.env
Slice=tg-agents.slice
# Пер-агентный disconnect с паузой 15-22с после каждого агента (см.
# funnel-collect.ts disconnectAfterEachAgent) удлиняет прогон: ~85 активных
# агентов × ~18с ≈ 26 мин пауз + сбор. Лимит поднят 45мин→2ч (2026-09-20): пока
# в пуле есть битые прокси, коннекты к ним (даже 3×20с) добавляют минуты, и 45мин
# не хватало — прогон убивался на середине. 7200с — запас до починки прокси.
TimeoutStartSec=7200
StandardOutput=journal
StandardError=journal
