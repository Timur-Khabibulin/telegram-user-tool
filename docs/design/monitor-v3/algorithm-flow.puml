@startuml monitor-v3-algorithm-flow
' Полный алгоритм одного прогона monitor-v3 (design-v1.md). Каданс - раз в
' 5ч. Состояние канала - поле status (общее с monitor-v2: banned/suspend/
' format_error), новые значения - only_comment и sleep. Цикл (§0.5) идёт
' только по каналам с публичным username И активным статусом (NULL/
' format_error/only_comment) - фильтр на уровне выборки, тем же способом,
' что monitor-v2 исключает banned/suspend в getChannelsBatch; banned/
' suspend/sleep в цикл не попадают вовсе, отдельная проверка не нужна.
'
' Номера узлов (§0-§2) соответствуют разделам design-v1.md - PlantUML не
' поддерживает autonumber для activity-диаграмм, нумерация проставлена вручную
' для сверки диаграммы с текстом.

start

partition "§0 Подготовка (раз за прогон)" {
  :§0.1 Загрузить сессию аккаунта;
  :§0.2 Синхронизировать список каналов агента;
  :§0.3 Резолвить идентичность ещё\nне резолвленных каналов (по частям);
  :§0.4 Снять просроченные приостановки\nstatus = banned/suspend/format_error/sleep;
  note right: only_comment сюда не входит - он не\nочищается в NULL по сроку, а переходит\nв sleep (см. §2a), это делает сам monitor-v3
  :§0.5 Выбрать каналы с публичным username\nИ активным статусом (NULL/format_error/only_comment);
  note right: фильтр на уровне выборки - как\nmonitor-v2 исключает banned/suspend\nв getChannelsBatch, не проверкой в цикле
}

while (§0.5 ещё есть выбранный канал\nдля обработки?) is (да)

  partition "§1 Проверка удалённых сообщений (channel-suspend-on-deletion,\nкак в monitor-v2)" {
    :Если агент отправлял сообщения в канал\nза окно проверки - проверить,\nсколько из них ещё существует;
    if (удалённых больше порога?) then (да)
      #pink:status = suspend (на срок);
      :зафиксировать ошибку (messages_deleted);
      :пометить канал обработанным;
    else (нет)

      if (status = only_comment?) then (да)

        partition "§2a only_comment" {
          if (прошло >= 2 суток с установки статуса?) then (да)
            :status = sleep (на 1 сутки);
            note right: дальше в этом прогоне для\nканала ничего не делаем
          else (нет)
            :Проверить непрочитанные сообщения\nв отслеживаемой ветке (watchedThreadRootMsgId);
            if (есть новые?) then (нет)
              :ничего не делать;
            else (да)
              :Забрать сообщения, выделить те,\nчто продолжают отслеживаемую ветку;
              :Сгенерировать и отправить ответ\n(история ветки + новые сообщения);
              note right: исход отправки - §2b.vi ниже
              :пометить обработанные сообщения\nпрочитанными;
              :зафиксировать визит канала\nи ошибки отправки (если были);
            endif
          endif
        }

      else (нет - status NULL / format_error)

        partition "§2b Ветка «Открыт»" {
          :§2b.i Забрать по веб-превью канала id, дату\nи текст последнего поста;
          note right: несколько постов за интервал -\nберётся только последний, более\nранние реакции не получат

          if (§2b.ii id поста = lastSeenChannelPostId?) then (да)
            #pink:ничего не делать;
            note right: защита от повторной реакции\nна тот же пост (канал постит редко)
          else (нет)
            if (§2b.iii возраст поста >= 24ч?\n(R1, freshness-gate)) then (да)
              #pink:ничего не делать;
            else (нет, < 24ч)
              :§2b.iv Отсев текста поста\n(короткий / без букв / только медиа);
              if (прошёл отсев?) then (нет)
                #pink:ничего не делать;
              else (да)
                :§2b.iv LLM решает, писать ли\nкомментарий и какой - по тексту поста;
                if (решили писать?) then (нет)
                  #pink:ничего не делать;
                else (да)
                  :§2b.v Найти служебную копию поста\nв чате обсуждения (корень ветки);
                  :§2b.v Отправить сгенерированный комментарий;
                  :§2b.vi Исход отправки - та же классификация\nошибок, что в monitor-v2 (FLOOD_WAIT / PEER_FLOOD /\nбан на запись / запрет формата / прочая ошибка);
                  note right
                    полный разбор исходов - design-v1.md §2b.vi
                    (переиспользован из monitor-v2 без изменений)
                    ----
                    §2b.vii при успехе: lastSeenChannelPostId = id поста,
                    watchedThreadRootMsgId = id служебной копии,
                    status = only_comment (на 2 суток)
                  end note
                endif
              endif
            endif
          endif
        }

      endif
    endif
  }

endwhile (нет)

stop

@enduml
