' ─────────────────────────────────────────────────────────────────────
' discovery.db (admin-only) — discoveryDbPath
' ─────────────────────────────────────────────────────────────────────
package "discovery.db  (admin-only)" #FFF0F0 {

    entity "discovered_channels" as discovered {
        * canonical_link : TEXT <<PK>>
        --
        assigned_agent : TEXT
        * added_at : INTEGER
        banned_at : INTEGER
    }

    note as N_discovery_db
      <b>Назначение.</b> Реестр найденных каналов на всю платформу (только у админ-агента).
      ----
      <b>Таблицы</b>
      • discovered_channels — дедуп по канонической ссылке (PK), назначение каналу агента
      ----
      <b>Статусов нет.</b> Инвариант «один канал — один агент навсегда» держится на PK.
      ----
      <b>assigned_agent</b> · NULL = канал в пуле прогона сбора (discovery-similar-parallel v2);
      фаза distribute заполняет. Исторические строки (до v2) — не NULL.
      ----
      <b>banned_at</b> · NULL = активен, иначе unix-сек бана (leave-banned-channels).
      assigned_agent при бане не меняется и строка не удаляется.
    end note
}

' ─────────────────────────────────────────────────────────────────────
' agent-restrictions.db (admin-only) — agentRestrictionsDbPath
' ─────────────────────────────────────────────────────────────────────
package "agent-restrictions.db  (admin-only)" #FDE9E0 {

    entity "agent_restrictions" as agent_restrictions {
        * agentId : TEXT <<PK>>
        --
        * restriction_type : TEXT
        * reason : TEXT
        restriction_duration : INTEGER
        * restricted_at : INTEGER
    }

    note as N_agent_restrictions_db
      <b>Назначение.</b> Ограничения агентов платформы (telegram-error-handling)
      — одна БД на всю платформу, не per-agent. Наличие строки = агент
      ограничен, отсутствие = не ограничен. Диспетчер проверяет перед
      запуском задач любого агента.
      ----
      <b>restriction_type</b>
      • need_update_session — сессия/конфиг невалидны (№1-4, 8). Бессрочно,
        снимается только вручную.
      • banned — аккаунт удалён/забанен/заморожен (№5, 6, 11, 12). Бессрочно,
        снимается только вручную.
      • suspend — временный анти-спам бан (PEER_FLOOD, №29, 1 день) либо
        2 забаненных канала за 2 дня (3 дня, дефолт). Снимается автоматически
        по истечении restriction_duration.
    end note
}

' ─────────────────────────────────────────────────────────────────────
' pending-reviews.db (per-agent) — pendingReviewsDbPath
' ─────────────────────────────────────────────────────────────────────
package "pending-reviews.db  (per-agent)" #E8EAF6 {

    entity "pending_reviews" as pending_reviews {
        * id : INTEGER <<PK>>
        --
        * chatId : TEXT
        * postId : INTEGER
        * postText : TEXT
        * llmScore : REAL
        llmAxes : TEXT (JSON)
        * comment : TEXT
        * rootMsgId : INTEGER
        * status : TEXT
        * createdAt : INTEGER
        resolvedAt : INTEGER
    }

    note as N_pending_reviews_db
      <b>Назначение.</b> Очередь ручного подтверждения комментария перед
      отправкой (post-comment-review) — заполняется, только если для
      агента включён review-gate (tg-account.json, reviewGateEnabled).
      ----
      Только у агентов с включённым review-gate — файл создаётся лениво
      при первой постановке поста на ревью.
    end note

    note bottom of pending_reviews
      <b>status</b> · начальный: pending
      ----
      • pending — ожидает решения человека (без TTL — может остаться
        бессрочно, если никто не нажал кнопку)
      • approved — отправлено («Да»)
      • rejected — отклонено («Нет»), пост помечен просмотренным
      ----
      <b>Переходы:</b> pending → approved | rejected (безусловно, независимо
      от исхода — решение 10 design.md post-comment-review). Отдельного
      append-only лога решений нет — статус и resolvedAt пишутся в ту же
      строку, llmScore/llmAxes уже рядом для сопоставления с llm_log.
    end note
}

' ─────────────────────────────────────────────────────────────────────
' Связи
' ─────────────────────────────────────────────────────────────────────

' Единственный реальный FK (в пределах одного файла):
gtam }o--|| group_threads : threadId → id

' Логические связи по agent_id (один файл funnel.db, без FK):
daily_stats }o..o{ snapshots : agent_id

' Логические межтабличные связи внутри tg-channels.db (по chatId / userId, без FK):
dm_candidates }o..|| channels : sourceChatId → chatId
dm_history    }o..o{ dm_candidates : userId

' Логические межфайловые связи (FK невозможны — разные файлы SQLite):
replies        }o..|| channels : chatId
group_threads  }o..|| channels : chatId
dm_threads     }o..o{ dm_candidates : userId
runs           }o..|| tasks : (agentId, type)
pending_reviews }o..|| channels : chatId

legend right
  | Обозначение | Значение |
  | <<PK>> | первичный ключ |
  | <<U>>  | UNIQUE |
  | <<FK>> | внешний ключ |
  | сплошная линия | FK в пределах файла |
  | пунктир | логическая связь (FK нет: разные файлы / по соглашению) |
  | per-agent | файл у каждого агента |
  | admin-only | файл только у админ-агента (agent1) |
endlegend

@enduml