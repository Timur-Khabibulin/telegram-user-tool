@startuml db-schema
' ER-диаграмма всех сущностей платформы, сгруппированных по файлам SQLite.
' Источник истины — схемы в src/core/db/*.ts и src/core/config.ts (пути к БД).
' PK — первичный ключ, U — UNIQUE, FK — внешний ключ.
'
' Файлы БД лежат в ~/.openclaw/workspace-<agentId>/:
'   per-agent  — по одному файлу у каждого агента;
'   admin-only — только у админ-агента (agent1): funnel.db, discovery.db.

hide circle
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam shadowing false

' ─────────────────────────────────────────────────────────────────────
' tg-channels.db (per-agent) — channelsDbPath
' ─────────────────────────────────────────────────────────────────────
package "tg-channels.db  (per-agent)" #E8F0FE {

    entity "channels" as channels {
        * chatId : TEXT <<PK>>
        --
        * title : TEXT
        * lastProcessedAt : INTEGER
        channelId : TEXT
        channelAccessHash : TEXT
        channelUsername : TEXT
        * channelResolved : INTEGER
        status : TEXT
        statusUpdatedAt : INTEGER
        lastSeenChannelPostId : INTEGER
        watchedThreadRootMsgId : INTEGER
        chatAccessHash : TEXT
        channel_context : TEXT
        channel_context_updated_at : INTEGER
        active_writers_p50 : REAL
        active_writers_p90 : REAL
        activity_updated_at : INTEGER
    }

    entity "dm_candidates" as dm_candidates {
        * id : INTEGER <<PK>>
        --
        * userId : TEXT
        userAccessHash : TEXT
        * sourceChatId : TEXT
        * msgId : INTEGER
        * msgText : TEXT
        score : REAL
        scoreReason : TEXT
        status : TEXT
        * createdAt : INTEGER
        --
        U (sourceChatId, msgId)
    }

    entity "dm_history" as dm_history {
        * id : INTEGER <<PK>>
        --
        * userId : TEXT
        * userAccessHash : TEXT
        username : TEXT
        * triggerText : TEXT
        * dmText : TEXT
        * sentAt : INTEGER
        * lastAgentMsgAt : INTEGER
        replyCount : INTEGER
        status : TEXT
    }

    entity "banned_channels" as banned_channels {
        * chatId : TEXT <<PK>>
        --
        * detectedAt : INTEGER
    }

    note as N_channels_db
      <b>Назначение.</b> Рабочее состояние группового монитора агента.
      ----
      <b>Таблицы</b>
      • channels — обойдённые чаты и их период обхода
      • dm_candidates — кандидаты на DM, отобранные из групп
      • dm_history — журнал отправленных DM
      • banned_channels — очередь каналов на выход (leave-banned-channels)
    end note

    note bottom of banned_channels
      <b>Назначение.</b> Очередь работ скилла leave-banned-channels: каналы,
      где монитор получил CHAT_WRITE_FORBIDDEN.
      ----
      <b>Статусов нет.</b> Строка живёт от постановки (enqueueBannedChannel)
      до обработки (выход из канала + purgeChannelData), затем удаляется.
    end note

    note bottom of dm_candidates
      <b>status</b> · начальный: pending
      ----
      • pending — ожидает обработки
      • sent — DM отправлен
      • skipped — пропущен (фильтр или ошибка отправки)
      • privacy_blocked — у пользователя закрыта личка
      • deactivated — аккаунт пользователя удалён
      • expired — старше N дней без отправки
      ----
      <b>Переходы:</b> pending → sent | skipped | privacy_blocked | deactivated | expired
    end note

    note bottom of dm_history
      <b>status</b> · начальный: sent
      ----
      • sent — DM отправлен (иных значений код пока не пишет)
    end note

    note bottom of channels
      <b>status</b> (telegram-error-handling) · начальный: NULL
      ----
      • NULL — обычная работа, ограничений нет
      • banned — CHAT_WRITE_FORBIDDEN/USER_BANNED_IN_CHANNEL (при отправке).
        Останавливает обработку канала в monitor-v2 (проверяется перед
        обработкой). Ставится в banned_channels, снимается только выходом
        из канала (leave-banned-channels) — статус не сбрасывается.
      • format_error — CHAT_SEND_PLAIN_FORBIDDEN/CHAT_SEND_MEDIA_FORBIDDEN/
        ALLOW_PAYMENT_REQUIRED. НЕ останавливает обработку канала.
        Снятие не определено (открытый вопрос, вне скоупа).
      • only_comment (channel-post-watch, monitor-v3) — 2 суток после
        комментария к посту, канал проверяется на новые ответы в ветке
        (watchedThreadRootMsgId). Переход в sleep — вручную, monitor-v3.
      • sleep (channel-post-watch, monitor-v3) — ещё 1 сутки после
        only_comment (итого 3 суток от комментария), канал не проверяется
        вовсе. Снимается общим механизмом истечения статуса.
      • suspend (channel-suspend-on-deletion) — временное ограничение на
        statusDurationSeconds; снимается автоматически по истечении.
      • should_leave — оператор вручную решил, что канал агенту больше не
        нужен. Ставится в очередь на выход (leave-banned-channels).
      • leaved_from_banned / leaved_manual (leave-banned-channels) —
        терминальные: агент вышел из канала (после banned / should_leave
        соответственно). Единственные статусы, исключаемые из «каналов у
        агента» в funnel-report (countChannels) — канал физически потерян.
      • not_found — канал пропал из диалогов агента (не найден при синке).
      ----
      getChannelsBatch (monitor-v2..v5) исключает из обхода:
      banned, suspend, leaved_from_banned, leaved_manual, should_leave,
      not_found — то, что монитору сейчас нельзя/незачем трогать.
      ----
      <b>lastSeenChannelPostId</b> (channel-post-watch) — id последнего
      поста канала (в его собственной нумерации), на который агент
      отреагировал; не сбрасывается по истечении only_comment/sleep —
      защита от повторной реакции на тот же пост.
      <b>watchedThreadRootMsgId</b> (channel-post-watch) — id служебной
      копии этого поста в чате обсуждения; актуален, пока status =
      only_comment.
      <b>chatAccessHash</b> (post-comment-review) — персистентный accessHash
      чата обсуждения (отдельно от channelAccessHash — accessHash самого
      broadcast-канала). Заполняется оппортунистически, когда peerCache
      TelegramService и так его узнаёт. Нужен, чтобы review-listener на
      свежем MTProto-соединении мог собрать InputPeer без похода в getDialogs.
      ----
      <b>channel_context</b> / <b>channel_context_updated_at</b> (channel-context) —
      свободное текстовое описание канала (10-50 строк, без фиксированной
      структуры), собираемое фоновой периодической задачей раз в 90 дней на
      канал (about + закреп + посты + комментарии → один LLM-вызов). NULL —
      анализ ещё не проводился. status (banned/suspend) не исключает канал из
      отбора на анализ.
      ----
      <b>active_writers_p50</b> / <b>active_writers_p90</b> / <b>activity_updated_at</b>
      (channel-activity-percentiles) — 50-й/90-й перцентиль числа уникальных
      отправителей сообщений в сутки за скользящее окно 7 дней, TTL-метка
      последнего пересчёта (30 дней — окно данных и частота пересчёта не
      совпадают специально). Считается тем же скриптом, что и avg_views/
      subs_count (channel-activity-update.ts), независимым TTL. NULL —
      ещё не считалось.
    end note
}

