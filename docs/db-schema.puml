' tasks.db (per-agent) — tasksDbPath
' ─────────────────────────────────────────────────────────────────────
package "tasks.db  (per-agent)" #F3E8FD {

    entity "tasks" as tasks {
        * agentId : TEXT <<PK>>
        * type : TEXT <<PK>>
        --
        * schedule : TEXT (cron)
        * tz : TEXT
        lastRun : INTEGER
        * nextRun : INTEGER
        * enabled : INTEGER
    }

    entity "runs" as runs {
        * id : INTEGER <<PK>>
        --
        * agentId : TEXT
        * type : TEXT
        * startedAt : INTEGER
        * durationMs : INTEGER
        * status : TEXT
        error : TEXT
        * llmCalls : INTEGER
        * createdAt : INTEGER
    }

    entity "error_log" as error_log {
        * id : INTEGER <<PK>>
        --
        * skill_type : TEXT
        * errorMessage : TEXT
        * occured_at : INTEGER
    }

    note as N_tasks_db
      <b>Назначение.</b> Планировщик агента: расписание задач, журнал прогонов,
      журнал ошибок аккаунта.
      ----
      <b>Таблицы</b>
      • tasks — расписание задач-скиллов (cron + tz, enabled = 0|1)
      • runs — журнал прогонов: исход, длительность, число LLM-вызовов
      • error_log — append-only лог срабатываний ошибок аккаунта
        (telegram-error-handling)
    end note

    note bottom of runs
      <b>status</b> · начального нет (ставится при записи прогона)
      ----
      • success — прогон завершился успешно
      • error — прогон упал (текст в поле error)
    end note

    note bottom of error_log
      <b>Статусов нет.</b> Append-only — пишется при каждом срабатывании
      ошибок аккаунта (№1-6, 8, 11, 12, 21, 29, «2 канала banned за 2 дня»),
      независимо от того, создаётся ли при этом запись в agent_restrictions.
    end note
}

