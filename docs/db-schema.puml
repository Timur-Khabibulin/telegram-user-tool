package "tg-replies.db  (per-agent)" #E6F4EA {

    entity "replies" as replies {
        * id : INTEGER <<PK>>
        --
        * chatId : TEXT
        * msgId : INTEGER
        msgText : TEXT
        replyMsgId : INTEGER
        * replyText : TEXT
        * sentAt : INTEGER
    }

    entity "group_threads" as group_threads {
        * id : INTEGER <<PK>>
        --
        * chatId : TEXT
        * startMsgId : INTEGER
        * status : TEXT
        * lastActivityAt : INTEGER
        * messages : TEXT (JSON)
    }

    entity "group_thread_agent_msgs" as gtam {
        * agentMsgId : INTEGER <<PK>>
        * chatId : TEXT <<PK>>
        --
        * threadId : INTEGER <<FK>>
    }

    note as N_replies_db
      <b>Назначение.</b> Ответы агента в группах и групповые треды-диалоги.
      ----
      <b>Таблицы</b>
      • replies — отправленные ответы агента в группах
      • group_threads — состояние и история сообщений треда
      • group_thread_agent_msgs — индекс «сообщение агента → тред»
    end note

    note bottom of group_threads
      <b>status</b> · начальный: active
      ----
      • active — тред идёт
      • expired — нет активности дольше порога
      ----
      <b>Переходы:</b> active → expired
    end note
}

